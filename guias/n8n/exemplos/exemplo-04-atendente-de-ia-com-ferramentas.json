      "typeVersion": 1,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "operation": "typing",
        "sessionId": "",
        "to": "={{ $json.responderPara }}"
      },
      "id": "e9c25bda-6d3b-480c-948d-554a0290a118",
      "name": "Digitando…",
      "type": "n8n-nodes-astracalls.astraCalls",
      "typeVersion": 1,
      "position": [
        224,
        0
      ]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "={{ $('AstraCalls Trigger').item.json.texto }}",
        "options": {
          "systemMessage": "=Você é o atendente virtual da Loja Exemplo no WhatsApp. Responda em português, de forma curta e simpática.\nO cliente se chama {{ $('AstraCalls Trigger').item.json.nome }} e o telefone dele é {{ $('AstraCalls Trigger').item.json.responderPara }}.\nSe ele pedir para falar por voz, use a ferramenta de ligar. Se perguntar onde fica a loja, envie a localização."
        }
      },
      "id": "4ba99abe-212c-487e-aded-71a2e73e5fbc",
      "name": "AI Agent",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
