      ],
      "parameters": {
        "sessionId": "",
        "events": [
          "group_participants"
        ],
        "options": {
          "ignoreFromMe": true
        }
      }
    },
    {
      "id": "4f36381e-17b2-4b0e-84f5-19cd0a3d66d4",
      "name": "Entrou alguém?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        220,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": false,
            "leftValue": "",
