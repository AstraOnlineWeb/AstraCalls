          "conditions": [
            {
              "id": "484b6741-124a-4649-8fe6-859d9f032af1",
              "leftValue": "={{ ($json.entraram || []).length }}",
              "operator": {
                "type": "number",
                "operation": "gt"
              },
              "rightValue": 0
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "f1266ed5-ff3a-4300-afdd-e7ed6dca5077",
      "name": "Montar menções",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        -60
      ],
      "parameters": {
        "jsCode": "const it = $input.first().json;\nconst nums = (it.entraram || []).map(j => String(j).split('@')[0].split(':')[0]);\nreturn [{ json: { grupo: it.grupo, nums, texto: 'Bem-vindo(a) ' + nums.map(n => '@' + n).join(' ') + '! 🎉\\nLeia as regras na descrição do grupo.' } }];"
      }
    },
    {
      "id": "5981be3e-447e-4d88-b539-39f90f73a223",
      "name": "Enviar boas-vindas",
      "type": "n8n-nodes-astracalls.astraCalls",
      "typeVersion": 1,
      "position": [
        660,
        -60
      ],
      "parameters": {
        "sessionId": "",
        "resource": "message",
        "operation": "sendText",
        "to": "={{ $json.grupo }}",
        "text": "={{ $json.texto }}",
        "textOptions": {
          "mentions": "={{ $json.nums.join(',') }}"
        }
      }
    }
  ],
