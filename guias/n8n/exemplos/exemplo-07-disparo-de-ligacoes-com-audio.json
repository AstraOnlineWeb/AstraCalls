            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "c51b6a81-0ede-49b0-8a8a-319739123f18",
      "name": "Disparar ligações",
      "type": "n8n-nodes-astracalls.astraCalls",
      "typeVersion": 1,
      "position": [
        440,
        0
      ],
      "parameters": {
        "sessionId": "",
        "resource": "call",
        "operation": "broadcast",
        "numbers": "={{ $json.numeros }}",
        "mediaSource": "url",
        "mediaUrl": "={{ $json.audio }}",
        "video": false,
        "broadcastOptions": {
          "concurrency": 1,
          "gapSeconds": 5,
          "maxRingSeconds": 30,
          "hangupAfterSeconds": 60
        }
      }
    },
    {
