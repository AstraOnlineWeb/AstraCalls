        0
      ],
      "parameters": {
        "sessionId": "",
        "resource": "call",
        "operation": "broadcastStatus",
        "campaignId": "={{ $('Disparar ligações').item.json.campaignId || $('Disparar ligações').item.json.id }}"
      }
    },
    {
      "id": "c97cfb51-c06f-4adb-bc99-c15bead34adb",
      "name": "Resumo",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1100,
        0
      ],
      "parameters": {
        "jsCode": "const r = $input.first().json;\nconst res = r.results || [];\nconst atend = res.filter(x => ['answered','completed'].includes(x.status));\nreturn [{ json: { total: res.length, atenderam: atend.length, naoAtenderam: res.length - atend.length, detalhes: res } }];"
      }
    }
