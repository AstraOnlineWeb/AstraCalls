        "text": "=Olá, {{ $json.nome || 'tudo bem' }}! 👋\nRecebemos sua mensagem: \"{{ $json.texto }}\".\nJá já alguém da equipe responde.",
        "textOptions": {
          "quotedMessageId": "={{ $json.idMensagem }}"
        }
      },
      "id": "5b0f3c1e-0c7a-4a51-9a40-6f0a1d6c0a02",
      "name": "Responder",
      "type": "n8n-nodes-astracalls.astraCalls",
      "typeVersion": 1,
      "position": [520, 300]
    }
  ],
  "connections": {
    "Quando chegar mensagem": {
      "main": [
        [
          {
            "node": "Responder",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "pinData": {}
}
