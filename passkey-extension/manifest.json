{
  "manifest_version": 3,
  "name": "AstraCalls Passkey Connector",
  "version": "1.0.0",
  "description": "Autoriza a conexão de contas WhatsApp protegidas por passkey no AstraCalls. A confirmação (biometria/PIN) roda no navegador do dono da conta.",
  "permissions": ["scripting", "tabs"],
  "host_permissions": [
    "https://web.whatsapp.com/*",
    "https://call.trecofantastico.com.br/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://call.trecofantastico.com.br/*"],
      "js": ["bridge.js"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "AstraCalls Passkey",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
